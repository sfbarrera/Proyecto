# Copiar a .env y ajustar. Nunca subir .env al repositorio.

# ---- Base de datos ----
POSTGRES_USER=citae
POSTGRES_PASSWORD=cambiar_en_local
POSTGRES_DB=citae_lab
DATABASE_URL=postgresql+asyncpg://citae:cambiar_en_local@postgres:5432/citae_lab

# ---- Cache y leases ----
REDIS_URL=redis://redis:6379/0

# ---- Bus de eventos ----
RABBITMQ_DEFAULT_USER=citae
RABBITMQ_DEFAULT_PASS=cambiar_en_local
RABBITMQ_URL=amqp://citae:cambiar_en_local@rabbitmq:5672/

# ---- Almacenamiento de artefactos (MinIO en local, GCS en la nube) ----
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=citae
S3_SECRET_KEY=cambiar_en_local
S3_BUCKET=artefactos

# ---- Identidad ----
JWT_SECRET=cambiar_en_local
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DIAS=7

# ---- Agente local ----
AGENTE_ID=agente-laboratorio-01
AGENTE_URL_NUBE=http://bff-web:8080
AGENTE_DB=/datos/agente.sqlite
# 'simulado' usa el driver SCPI simulado; 'real' usa PyVISA contra instrumentos fisicos
AGENTE_MODO=simulado
